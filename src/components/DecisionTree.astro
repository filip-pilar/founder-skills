---
import { skills } from '../data/skills';
---
<section id="which-skill" class="mx-auto max-w-[1100px] px-6 pb-24">
  <h2 class="text-3xl sm:text-4xl mb-4">What are you working on?</h2>
  <p class="text-[var(--color-text-muted)] mb-8">Each workflow has one distinct job, with a complete example to help you choose.</p>
  <div class="grid md:grid-cols-2 gap-x-12">
    {skills.map(skill => (
      <a href={`/skills/${skill.id}`} class="block py-5 border-b border-[var(--color-border)] hover:text-[var(--color-accent-warm)]">
        <span class="block font-medium mb-1">{skill.name} &rarr;</span>
        <span class="block text-sm text-[var(--color-text-muted)]">{skill.description}</span>
      </a>
    ))}
  </div>
</section>
